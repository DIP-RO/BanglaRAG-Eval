# BanglaRAG-Eval — environment variable template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; NEVER
# commit real keys. Automatic evaluators and RAG backends read credentials
# from the environment only — no key is ever hard-coded in source.
#
# All variables below are OPTIONAL for Milestone 1 (the validation suite
# runs with no paid APIs). They exist to document the convention before
# evaluator/RAG adapters land in Milestone 2.

# --- Local LLM via Ollama (no paid API needed) ---
# Ollama runs locally at http://localhost:11434 by default.
# Install: https://ollama.com  |  Pull model: ollama pull qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# --- LLM judge / generator providers (Milestone 2+) ---
# OpenAI-compatible endpoint for LLM-as-judge and/or generation.
# OPENAI_API_KEY=

# Anthropic Claude (independent LLM judge, cross-model to limit self-preference).
# ANTHROPIC_API_KEY=

# Generic OpenAI-compatible base URL + key for self-hosted / local models.
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=local-no-key

# --- RAGAS / ARES dependencies (Milestone 2+) ---
# RAGAS uses the same LLM provider keys above; no separate key is required.
# ARES may require an annotation LLM key (reuses OPENAI_API_KEY by default).

# --- SemFuse RAG backend (Milestone 2+, if integrated) ---
# SEMFUSE_BASE_URL=
# SEMFUSE_API_KEY=

# --- Reproducibility / run config (optional overrides) ---
# Pilot config path (defaults to configs/pilot_stage1.yaml).
# BANGLARAG_PILOT_CONFIG=configs/pilot_stage1.yaml
